# Credentials. Nothing here is currently in the repository and nothing should
# ever be: publishing reads its keys from ~/.gradle/gradle.properties or the
# environment, never from the tree. These patterns exist so that a signing key
# or a registry token exported into the working directory by accident cannot be
# committed by a hurried `git add -A`.
.env
.env.*
.npmrc
*.asc
*.gpg
secring.*
*.jks
*.keystore
*.p12

# gradle
.gradle/
build/
local.properties
*.hprof

# GRA-201: one fixture file deliberately lives under a directory named
# build/ -- sources.test.ts's proof that the source-location walk skips
# build output, which needs a real build/ directory on disk to skip. `build/`
# above stops git from recursing into it at all, so a plain negation on the
# file itself would never be reached; both the directory and its contents
# have to be re-included explicitly.
!mcp/src/fixtures/sources/app/build/
!mcp/src/fixtures/sources/app/build/**

# node
node_modules/
dist/
coverage/
*.tgz

# JUnit XML the vitest suites write when run with --reporter=junit
# (CI does this; a local run reproducing that shape must not dirty the tree).
mcp/test-results/

# The npm package publishes dist/ and ui/dist/ through its `files` allowlist,
# which wins over this file — verified with `npm pack --dry-run`. Ignoring them
# here keeps build output out of git without keeping it out of the tarball.

# ide
.idea/
.vscode/
.fleet/
*.iml

# android studio
captures/
.cxx/

# os
.DS_Store
Thumbs.db
desktop.ini

# porthole runtime output
.porthole/

# The agent config portholeMcpConfig writes at the root when the sample is
# run from this checkout. Its env block carries this machine's absolute
# paths, so it is regenerated per machine, never shared.
.mcp.json
.mcp.json.bak

# kotlin compiler session files
.kotlin/

# vite / tsc build info
*.tsbuildinfo

# vercel cli, which writes the project and org id here on first deploy
.vercel/

# python bytecode cache, from running tools/test_check_readme_test_counts.py
__pycache__/

# site/api is deliberately NOT ignored. It is Dokka output, committed on
# purpose, because the host that serves it cannot build it. See the README.

.vercel
.env*
