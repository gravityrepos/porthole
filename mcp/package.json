{
  "name": "@gravitylabsllc/porthole",
  "version": "0.2.0",
  "description": "MCP server and live timeline for Porthole: query a running Android app for recomposition counts, frame timing, main-thread stalls, navigation, state, in-flight work and logs, and capture and query Perfetto system traces.",
  "type": "module",
  "bin": {
    "porthole": "dist/cli.js",
    "porthole-mcp": "dist/index.js"
  },
  "files": [
    "README.md",
    "dist",
    "ui/dist",
    "src/*.ts",
    "!src/*.test.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspace porthole-ui && tsc",
    "build:server": "tsc",
    "build:ui": "npm run build --workspace porthole-ui",
    "dev:ui": "npm run dev --workspace porthole-ui",
    "dev:server": "tsc --watch",
    "lint": "npm run lint --workspace porthole-ui",
    "format": "npm run format --workspace porthole-ui",
    "start": "node dist/index.js",
    "ui": "node dist/cli.js ui",
    "mock": "node tools/mock-device.mjs",
    "test": "vitest run",
    "test:ui": "npm run test --workspace porthole-ui",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravityrepos/porthole.git"
  },
  "homepage": "https://github.com/gravityrepos/porthole",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "android",
    "compose",
    "mcp",
    "debugging",
    "profiling",
    "jank"
  ],
  "workspaces": [
    "ui"
  ]
}
