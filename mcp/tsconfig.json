{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    // The maps emit `../src/<name>.ts`, so the published package has to carry
    // src/ for them to resolve to anything. `files` in package.json does that.
    // Turning maps off would be the other way out, but this is a debugging
    // tool: a stack trace from a user's terminal should point at the line they
    // can read, not at compiled output.
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  // Tests run from source through vitest, so compiling them only puts
  // them in dist — and `files` in package.json publishes dist wholesale,
  // which was shipping report.test.js and trace.test.js to npm.
  // `src/testing/**` is the same problem in a different shape: it is test
  // infrastructure (a fake device, an in-memory MCP client) that no test
  // filename regex catches because it isn't named `*.test.ts`. Left in,
  // GRA-90 added `dist/testing/harness.js` to the published tarball; vitest
  // still finds it fine because vitest transforms `src/**/*.ts` directly and
  // never looks at this file's compiled output.
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
